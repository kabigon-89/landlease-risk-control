<div class="contract-workspace" ng-if="!data.error">
  <h3>契約作業ワークスペース</h3>

  <div class="workspace-body">
    <div class="workspace-left">
      <div class="section">
        <h4>基本情報</h4>
        <label>相手方名称</label>
        <input type="text" class="form-control" ng-model="c.form.contractorName">

        <label>相手方担当者名</label>
        <input type="text" class="form-control" ng-model="c.form.contactPersonName">

        <label>相手方連絡先</label>
        <input type="text" class="form-control" ng-model="c.form.contactInfo">

        <label>貸付対象地</label>
        <input type="text" class="form-control" ng-model="c.form.propertyLocation">

        <label>貸付目的</label>
        <input type="text" class="form-control" ng-model="c.form.leasePurpose">

        <label>契約開始日</label>
        <input type="text" class="form-control" ng-model="c.form.startDate">

        <label>契約終了日</label>
        <input type="text" class="form-control" ng-model="c.form.endDate">
      </div>
    </div>

    <div class="workspace-right">
      <div class="section" ng-if="data.departmentLog">
        <h4>所管課やり取り履歴</h4>
        <div class="readonly-log">{{data.departmentLog}}</div>
      </div>

      <div class="section">
        <h4>経緯メモ（変更点・AIへの補足情報）</h4>
        <div class="readonly-log" ng-if="data.backgroundNotes">{{data.backgroundNotes}}</div>
        <textarea class="form-control" rows="8" ng-model="c.form.newNote"
                  ng-init="c.form.newNote = c.form.newNote || data.deptComment"
                  style="min-height: 180px; resize: vertical;"
                  placeholder="今回の変更点や、AIに伝えたい補足情報があれば入力してください"></textarea>
        <small ng-if="data.deptComment">※所管課の回答コメントを最初から入力しています。必要に応じて編集してください。</small>
      </div>

      <div class="section">
        <h4>契約書アップロード</h4>
        <label>契約書本体</label>
        <input type="file" accept="application/pdf" onchange="angular.element(this).scope().c.onPdfSelected(this.files)">

        <label>関連資料</label>
        <input type="file" multiple onchange="angular.element(this).scope().c.onRelatedFilesSelected(this.files)">
        <span class="related-files-loading" ng-if="c.relatedFilesLoading">
          <i class="fa fa-spinner fa-spin"></i> 関連資料を読み込み中...
        </span>
      </div>

      <div class="section action-section">
        <!-- 送信中(submitting)と審査中(checking)は、利用者から見て同じ「審査中」として1つの表示にまとめる -->
        <button class="btn btn-primary btn-check" ng-click="c.submit()" ng-disabled="c.submitting || c.checking || c.redirecting || c.relatedFilesLoading">
          {{c.redirecting ? '結果画面へ移動中...' : ((c.submitting || c.checking) ? '審査中...' : (c.relatedFilesLoading ? '関連資料を読み込み中...' : '契約書チェック'))}}
        </button>

        <div class="checking-status" ng-if="c.submitting || c.checking">
          <i class="fa fa-spinner fa-spin"></i>
          <span ng-if="!c.redirecting">AIが審査中です。数分かかる場合があります。しばらくお待ちください...</span>
          <span ng-if="c.redirecting">審査が完了しました。結果画面へ移動しています...</span>
        </div>
        <div class="error-message" ng-if="c.errorMessage">{{c.errorMessage}}</div>
      </div>
    </div>
  </div>
</div>
<div ng-if="data.error" class="alert alert-warning">{{data.error}}</div>