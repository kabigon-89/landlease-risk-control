api.controller = function($timeout) {
  var c = this;

  c.form = {
    contractorName: c.data.contractorName,
    contactPersonName: c.data.contactPersonName,
    contactInfo: c.data.contactInfo,
    propertyLocation: c.data.propertyLocation,
    leasePurpose: c.data.leasePurpose,
    startDate: c.data.startDate,
    endDate: c.data.endDate,
    newNote: ''
  };

  c.pdfFile = null;
  c.relatedFiles = [];
  c.relatedFilesLoading = false; // 関連資料のBase64変換が完了するまでtrue
  c.submitting = false;
  c.checking = false; // 2026-09-19: 非同期化に伴い復活。ポーリング中はtrue
  c.errorMessage = '';

  function fileToBase64(file, callback) {
    var reader = new FileReader();
    reader.onload = function(e) {
      var base64 = e.target.result.split(',')[1];
      callback({ name: file.name, type: file.type, base64: base64 });
    };
    reader.readAsDataURL(file);
  }

  c.onPdfSelected = function(fileList) {
    if (!fileList || fileList.length === 0) { return; }
    fileToBase64(fileList[0], function(result) {
      c.pdfFile = result;
      $timeout(function() {});
    });
  };

  c.onRelatedFilesSelected = function(fileList) {
    if (!fileList || fileList.length === 0) { return; }
    c.relatedFiles = [];
    c.relatedFilesLoading = true;
    $timeout(function() {});

    var remaining = fileList.length;
    for (var i = 0; i < fileList.length; i++) {
      fileToBase64(fileList[i], function(result) {
        c.relatedFiles.push(result);
        remaining--;
        if (remaining === 0) {
          c.relatedFilesLoading = false;
          $timeout(function() {});
        }
      });
    }
  };

  function callServer(payload, callback) {
    c.data.actionPayload = payload;
    c.server.update().then(function(response) {
      // 2026-09-19: このServiceNow環境ではc.server.update()の戻り値の形が
      // response.data.ajaxResult / response.ajaxResult のどちらの場合もあり、
      // 決め打ちで参照すると「response.dataがundefined」エラーになることがある
      // ため、両方を見るようにする。
      var result = (response && response.data && response.data.ajaxResult) ||
                   (response && response.ajaxResult);
      callback(result);
    }).catch(function(err) {
      console.error('Server update failed:', err);
      callback({ success: false, error: '通信エラーが発生しました。' });
    });
  }

  // 2026-09-19: 非同期化に伴い復活。ただし判定条件は「finding件数 > 0」ではなく
  // 「u_processing_status」を見る方式に変更した(以前の版は、Azure Function側が
  // まだ全条文を処理しきっていない途中の状態で誤って完了扱いにしてしまい、
  // Risk Review Split画面が不完全なデータを読み込んで白画面になる不具合があった)。
  function pollStatus(versionSysId, attemptsLeft) {
    if (attemptsLeft <= 0) {
      c.checking = false;
      c.errorMessage = 'AIの処理が想定より時間がかかっています。しばらくしてからRisk Review画面を開いてください。';
      return;
    }
    $timeout(function() {
      callServer({ action: 'check_status', version_sys_id: versionSysId }, function(result) {
        if (result && result.status === 'completed') {
          c.checking = false;
          window.location.href = '/risk_review?id=risk_review_split&version=' + versionSysId;
        } else if (result && result.status === 'failed') {
          c.checking = false;
          c.errorMessage = 'AIによる審査中にエラーが発生しました: ' + (result.error || '');
        } else {
          // 'processing' または 'unstarted' ならまだ完了していないので、次回もポーリング
          pollStatus(versionSysId, attemptsLeft - 1);
        }
      });
    }, 5000);
  }

  c.submit = function() {
    if (!c.pdfFile) {
      c.errorMessage = '契約書本体のPDFを選択してください。';
      return;
    }
    if (c.relatedFilesLoading) {
      c.errorMessage = '関連資料を読み込み中です。しばらく待ってから送信してください。';
      return;
    }
    c.errorMessage = '';
    c.submitting = true;

    var payload = {
      action: 'submit',
      version_sys_id: c.data.versionSysId,
      contractor_name: c.form.contractorName,
      contact_person_name: c.form.contactPersonName,
      contact_info: c.form.contactInfo,
      property_location: c.form.propertyLocation,
      lease_purpose: c.form.leasePurpose,
      start_date: c.form.startDate,
      end_date: c.form.endDate,
      new_note: c.form.newNote,
      pdf_file: c.pdfFile,
      related_files: c.relatedFiles
    };

    // 2026-09-19: submitはもう受付(202)を待つだけなのですぐ返る。
    // 実際の完了はu_processing_statusのポーリングで検知する。
    callServer(payload, function(result) {
      c.submitting = false;
      if (!result || !result.success) {
        c.errorMessage = (result && result.error) || '送信に失敗しました。';
        return;
      }
      c.checking = true;
      pollStatus(result.version_sys_id, 60); // 5秒×60回=最大5分待つ
    });
  };
};